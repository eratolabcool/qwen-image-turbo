# Qwen Image 2.1 Turbo — RunPod serverless worker.
# Copy to .env and fill in. deploy.sh sources .env if present.

RUNPOD_API_KEY=
IMAGE=eratolabcool/qwen-image-turbo
TAG=v1
# 48GB GPU is required: the full model is ~32GB in bf16.
# Cheaper 48GB alternative: NVIDIA A40 ($0.59/hr). Faster: NVIDIA L40S.
GPU_ID=NVIDIA L40S
MODEL_ID=Qwen/Qwen-Image-2.1-Turbo
